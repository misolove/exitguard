[Unit]
Description=ExitGuard GeoIP (DB-IP country lite) update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/exitguard/geoip-update.sh
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/exitguard
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
